# Set only in the server environment (Vercel Project Settings > Environment Variables).
# Never prefix secrets with VITE_ or inline them in browser code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# MCP tool access (server-only). Use a long random office access key.
# Users enter MCP_ACCESS_TOKEN into the tool panel; it is kept only in memory.
MCP_ACCESS_TOKEN=
# JSON array of explicitly allowed HTTPS Streamable HTTP servers/tools/departments.
# Example (replace the endpoint, tool name and upstream token with real values):
# MCP_SERVERS=[{"id":"office-tools","label":"Office tools","url":"https://tools.example.com/mcp","token":"upstream-token","tools":["search_documents"],"departments":["Executive","Production","Sales","Marketing","Finance","People"]}]
MCP_SERVERS=[]
